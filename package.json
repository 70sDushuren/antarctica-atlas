{
  "name": "antarctica-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Antarctica Atlas — Holistic Live Weather, Subglacial Geology & Exploration Heritage Digital Atlas (6 Locales: en, zh-CN, zh-TW, yue-Hant, pt, es)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/70sDushuren/antarctica-atlas.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:i18n && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "validate:i18n": "node --experimental-strip-types scripts/validate-i18n.mjs",
    "prep:geodata": "python3 scripts/data-pipeline/generate_polar_geodata.py",
    "verify": "npm run prep:geodata && npm run validate:i18n && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "next-intl": "^3.26.3",
    "proj4": "^2.15.0",
    "proj4leaflet": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/proj4": "^2.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  }
}
