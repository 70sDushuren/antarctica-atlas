# ==============================================================================
# Antarctica Atlas — Environment Configuration Template (Option A Serverless)
# Zero API keys are required for V1.0 baseline operation!
# Copy to `.env.local` only if overriding deployment URLs or optional 3D tokens.
# ==============================================================================

# Canonical site origin used for Next.js metadataBase, sitemap.xml, and hreflang SEO tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cesium Ion token if enabling high-res commercial terrain in 3D Globe mode
# Leave unset to use open-access WGS84 / NASA GIBS / Natural Earth globe layers
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
