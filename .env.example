# ==============================================================================
# Antarctica Atlas V2.0 — Environment Configuration Template
# Supports both $0 Serverless (Cloudflare/Vercel + Neon PostGIS) and
# Self-Hosted Docker VPS (PostgreSQL 17 + PostGIS 3.5 + PgBouncer).
# Note: When DATABASE_URL is omitted in local dev, a graceful local file store
# (.local-dev-store.json) activates automatically for zero-friction previewing.
# ==============================================================================

# Canonical site origin used for Next.js metadataBase, sitemap.xml, hreflang, and OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1. PostgreSQL + PostGIS Connection Strings (100+ Concurrent Connections Ready)
# Pooled connection (PgBouncer port 6432 locally, or Neon `-pooler` endpoint in cloud)
# DATABASE_URL=postgresql://atlas:atlas_polar_dev_2026@localhost:6432/antarctica_atlas
# Direct connection (Port 5432 locally, or Neon direct endpoint — used for schema migrations)
# DIRECT_DATABASE_URL=postgresql://atlas:atlas_polar_dev_2026@localhost:5432/antarctica_atlas

# 2. Self-Hosted Authentication Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET=antarctica-atlas-dev-only-replace-in-production-32bytes

# 3. Optional OAuth Providers (Leave blank to use self-contained Email + Password auth only)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 4. Optional Commercial Open-Meteo Endpoint Key
# Leave unset for personal/non-commercial use (routes to free api.open-meteo.com).
# Set when operating commercially to route automatically to customer-api.open-meteo.com.
# OPEN_METEO_API_KEY=

# 5. Daily IP Anonymization Salt Prefix for Privacy-Safe UV Analytics
TELEMETRY_HASH_PEPPER=antarctica-cryo-telemetry-v2
